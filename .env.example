# ElCache10 — nombres de variables (sin valores). Los valores reales van en Vercel.

# Clerk (panel /admin)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Lista blanca del panel: correos separados por comas. Se compara en minúsculas con el
# correo PRIMARIO VERIFICADO de la sesión de Clerk. Sin esta variable no entra nadie.
ADMIN_ALLOWED_EMAILS=

# Guardado de precios/ofertas y fotos en GitHub
ADMIN_GITHUB_TOKEN=
ADMIN_GITHUB_REPO=
ADMIN_GITHUB_BRANCH=
ADMIN_ALLOWED_HOSTS=
ADMIN_VERCEL_DEPLOY_HOOK_URL=

# Sincronización con citas.elcache10.com
STAFF_ROSTER_SYNC_KEY=
CITAS_STAFF_API_URL=
